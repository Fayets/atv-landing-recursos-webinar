# Local: sqlite. Producción: postgres (Neon compartida) con las variables DB_*.
DB_PROVIDER=sqlite
DB_FILENAME=recursos.sqlite

DB_USER=
DB_PASS=
DB_HOST=
DB_NAME=
DB_PORT=5432
DB_SSLMODE=require
DB_SCHEMA=recursos

CORS_ORIGINS=http://localhost:5177

# PIN del panel interno (/admin). Largo y al azar: 8 intentos fallidos bloquean la IP 15 min.
# Generarlo con: openssl rand -hex 8
ADMIN_PIN=

# Firma de los pases que da la contraseña correcta. Generarlo con: openssl rand -hex 32
RECURSOS_SECRET=

# Contraseña que Juan dice en vivo. No importan mayúsculas, espacios ni acentos.
# Una por área; si queda vacía se usa PASSWORD_DEFAULT.
PASSWORD_DEFAULT=losmentoreshighticket
PASSWORD_MARKETING=
PASSWORD_VENTAS=
PASSWORD_BACKEND=

# Chat de Juan al que lleva el candado (solo dígitos, con código de país).
# El mensaje sale solo: "Juan, quiero desbloquear <nombre del SOP>".
WHATSAPP_NUMBER=
